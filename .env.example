# FedShield-ID Environment Configuration

# Database Configuration (PostgreSQL for Docker, SQLite fallback for local dev)
# For local SQLite: sqlite:///./fedshield.db
# For Docker Compose PostgreSQL: postgresql://fedshield:securepassword@db:5432/fedshield_db
DATABASE_URL=postgresql://fedshield:securepassword@db:5432/fedshield_db

# PostgreSQL Credentials (used by docker-compose)
POSTGRES_USER=fedshield
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=fedshield_db
POSTGRES_PORT=5432

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production

# Frontend Configuration
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# Differential Privacy & Security Parameters
DEFAULT_EPSILON=2.0
ENCRYPTION_MODE=PQC
PQC_ALGORITHM=CRYSTALS-Kyber-768
